# Core application
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/scorelogic
AUTH_SECRET=dev-only-change-before-production-32-characters

# Optional self-hosted auth settings
AUTH_URL=http://127.0.0.1:3007
AUTH_TRUST_HOST=true
DAILY_TIME_ZONE=Europe/Istanbul
DAILY_BUFFER_DAYS_AHEAD=14

# Required in production; optional local distributed rate limiting via Upstash REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Railway has one trusted reverse-proxy hop. Keep 0 when no trusted proxy exists.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Required in production. Use separate secrets per environment.
OBSERVABILITY_HASH_SALT=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.10
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SYNTHETIC_MONITOR_TOKEN=
SYNTHETIC_BASE_URL=

# Encrypted PostgreSQL logical backups and restore drills.
# 32 bytes encoded as 64 hexadecimal characters or base64; use a production secret.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIRECTORY=.backups
BACKUP_MAX_RPO_HOURS=24
RESTORE_MAX_RTO_MINUTES=30
# Production backup cron uploads the encrypted dump + manifest to S3-compatible storage.
# Railway Buckets can inject these AWS_* aliases directly; external S3/R2/B2 also work.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_S3_URL_STYLE=virtual
BACKUP_S3_PREFIX=scorelogic/database-backups

# Bounded performance test overrides. Remote targets additionally require
# LOAD_TEST_ALLOW_REMOTE=true.
LOAD_TEST_BASE_URL=
LOAD_TEST_DURATION_SECONDS=15
LOAD_TEST_CONCURRENCY=12
LOAD_TEST_ALLOW_REMOTE=false

# Optional release correlation for Sentry/OTel deploys.
APP_RELEASE=
NEXT_PUBLIC_APP_RELEASE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
