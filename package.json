{
  "name": "scorelogic-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev --hostname 127.0.0.1 --port 3007",
    "local:up": "node scripts/local-up.mjs",
    "local:down": "node scripts/local-down.mjs",
    "local:status": "node scripts/local-status.mjs",
    "prebuild": "tsx scripts/validate-env.ts && node scripts/guard-build.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "prestart": "tsx scripts/validate-env.ts",
    "start": "next start",
    "start:local": "next start --hostname 127.0.0.1 --port 3007",
    "prestart:standalone": "tsx scripts/validate-env.ts",
    "start:standalone": "node scripts/start-standalone.mjs",
    "pretype-check": "next typegen",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration",
    "test:integration:local": "node scripts/run-local-integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "tsx scripts/deploy-migrations.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:publish": "tsx scripts/publish-puzzles.ts",
    "db:audit-content": "tsx scripts/audit-puzzle-content.ts",
    "db:daily-buffer": "tsx scripts/run-daily-buffer.ts",
    "db:editorial": "tsx scripts/manage-editorial-review.ts",
    "difficulty:calibrate": "tsx scripts/calibrate-difficulty.ts",
    "stats:reconcile": "tsx scripts/reconcile-stats.ts",
    "ops:backup": "tsx scripts/backup-database.ts",
    "ops:restore": "tsx scripts/restore-database.ts",
    "ops:restore-drill": "tsx scripts/drill-database-restore.ts",
    "ops:validate": "tsx scripts/validate-observability-config.ts",
    "ops:synthetic": "tsx scripts/run-synthetic-smoke.ts",
    "perf:check": "tsx scripts/check-performance-budgets.ts",
    "perf:load": "tsx scripts/run-load-test.ts",
    "perf:load:local": "node scripts/run-local-load.mjs",
    "db:release": "node scripts/release.mjs",
    "db:ensure-content": "tsx scripts/ensure-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.1102.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^5.20.0",
    "@sentry/nextjs": "^10.69.0",
    "@tanstack/react-query": "^5.59.0",
    "@upstash/ratelimit": "^2.0.4",
    "@upstash/redis": "^1.34.3",
    "@vercel/otel": "^2.1.3",
    "framer-motion": "^11.11.11",
    "jose": "^5.9.3",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.15.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^5.20.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
