# Public build configuration. Never place AUTH_SECRET, DATABASE_URL or credentials here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3109
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=true
EXPO_PUBLIC_WEB_ORIGIN=https://score-logic-app-test.up.railway.app
EXPO_PUBLIC_SCHEME=scorelogic-dev
# Android emulator: API URL may be http://10.0.2.2:3109 in a development build.
# Release builds require verified values; development identifiers cannot be released.
# MOBILE_APPLICATION_ID=
# Internal standalone build: MOBILE_PREVIEW=true, MOBILE_BUILD_NUMBER=2, HTTPS API/web origins.
# MOBILE_PREVIEW=
# MOBILE_LINK_HOST=
# EXPO_PROJECT_ID=

# Optional public support URL controlled by the product owner. In-app help always works.
# EXPO_PUBLIC_SUPPORT_URL=https://your-owned-domain.example/support
# EXPO_PUBLIC_BUILD_ID=

# Optional diagnostics, off by default. Requires a new native development build.
# EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false
# Public Sentry DSN is NOT the upload/auth token.
# EXPO_PUBLIC_SENTRY_DSN=
# Build-only upload configuration; never prefix upload credentials with EXPO_PUBLIC_.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Release build number (same positive integer for this iOS/Android build).
# MOBILE_BUILD_NUMBER=
