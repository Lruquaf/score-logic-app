{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development" },
    "simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": { "distribution": "internal", "environment": "preview", "env": { "MOBILE_PREVIEW": "true", "MOBILE_BUILD_NUMBER": "2" } },
    "production": { "environment": "production", "env": { "MOBILE_RELEASE": "true" } }
  }
}
