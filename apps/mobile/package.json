{
  "name": "scorelogic-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "design:studio": "MOBILE_DESIGN_STUDIO=true BROWSER=none expo start --web --localhost --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke:api": "node --import tsx scripts/smoke-api.ts",
    "export:native": "expo export --platform all --output-dir dist",
    "doctor": "expo-doctor",
    "test:components": "jest --config jest.config.cjs --runInBand",
    "smoke:gameplay": "node --import tsx scripts/smoke-gameplay.ts",
    "smoke:account": "node --import tsx scripts/smoke-account.ts",
    "smoke:resilience": "node --import tsx scripts/smoke-resilience.ts",
    "export:native:maps": "expo export --platform all --source-maps --output-dir dist",
    "check:export": "node scripts/check-export.mjs",
    "check:a11y": "node --import tsx scripts/check-accessibility.ts",
    "acceptance:init": "node --import tsx scripts/acceptance.ts init",
    "acceptance:check": "node --import tsx scripts/acceptance.ts check",
    "benchmark:local": "node --import tsx scripts/benchmark-local.ts",
    "device:android:check": "node scripts/check-android-device.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@scorelogic/contracts": "file:../../packages/contracts",
    "@sentry/react-native": "8.28.0",
    "expo": "58.0.25",
    "expo-clipboard": "58.0.4",
    "expo-crypto": "58.0.8",
    "expo-dev-client": "58.0.20",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-network": "58.0.5",
    "expo-secure-store": "58.0.3",
    "expo-sqlite": "58.0.17",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.8",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
