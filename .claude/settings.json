{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit *)",
      "Bash(npm run test:integration:local)",
      "Bash(npm run test:integration:local *)",
      "Bash(npm run perf:check)",
      "Bash(npm run local:status)",
      "Bash(npm run mobile:check)",
      "Bash(npm run test:mobile)",
      "Bash(npx vitest run *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm --prefix apps/mobile run type-check)",
      "Bash(npm --prefix apps/mobile test)",
      "Bash(npm --prefix apps/mobile run test:components)",
      "Bash(npm --prefix apps/mobile run check:a11y)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(rg *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production*)",
      "Read(./.local/secrets/**)",
      "Read(./.backups/**)",
      "Read(./apps/mobile/.env)",
      "Read(./apps/mobile/.env.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(npm run db:deploy *)",
      "Bash(npm run db:release *)",
      "Bash(npm run db:push *)",
      "Bash(npm run db:editorial *)",
      "Bash(npm run ops:backup *)",
      "Bash(npm run ops:restore *)",
      "Bash(npm run ops:restore-drill *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(railway *)",
      "Bash(eas *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@anthropic-plugin-directory": true
  }
}
